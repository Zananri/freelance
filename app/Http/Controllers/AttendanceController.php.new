namespace App\Http\Controllers;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;
use Carbon\Carbon;
use App\Models\Employee;
use App\Models\Attendance;
use Illuminate\Http\Request;

class AttendanceController extends Controller
{
    /**
     * Display a listing of the resource.
     */
  
    public function showAttendancePage()
    {
        $userId = Auth::id();
        $employee = Employee::with('division')->where('user_id', $userId)->first();

        // Debug log to check division data
        \Log::info('Employee division:', ['division' => $employee ? $employee->division : null]);

        return view('attendance/attendance', compact('employee'));
    }

    public function index()
    {
        //
    }

    /**
     * Get attendance data for AJAX requests
     */
    public function getAttendanceByDate(Request $request)
    {
        try {
            $date = $request->get('date');
            $employeeId = $request->get('employee_id');
            
            if (!$date || !$employeeId) {
                return response()->json([
                    'code' => 400,
                    'status' => 'error',
                    'data' => [],
                    'message' => 'Date and employee_id are required'
                ], 400);
            }

            $attendance = Attendance::where('employee_id', $employeeId)
                ->where('date_attendance', $date)
                ->orderBy('created_at', 'desc')
                ->get();

            return response()->json([
                'code' => 200,
                'status' => 'success',
                'data' => $attendance,
                'message' => 'Attendance data retrieved successfully'
            ]);

        } catch (\Exception $e) {
            \Log::error('Get attendance by date error:', ['error' => $e->getMessage()]);
            return response()->json([
                'code' => 500,
                'status' => 'error',
                'data' => [],
                'message' => 'Server error: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Get attendance calendar data
     */
    public function getCalendarData(Request $request)
    {
        try {
            $month = $request->get('month');
            $year = $request->get('year');
            $employeeId = $request->get('employee_id');
            
            if (!$month || !$year || !$employeeId) {
                return response()->json([
                    'code' => 400,
                    'status' => 'error',
                    'data' => [],
                    'message' => 'Month, year and employee_id are required'
                ], 400);
            }

            $startDate = Carbon::create($year, $month, 1)->startOfMonth();
            $endDate = Carbon::create($year, $month, 1)->endOfMonth();

            $attendance = Attendance::where('employee_id', $employeeId)
                ->whereBetween('date_attendance', [$startDate, $endDate])
                ->get()
                ->groupBy('date_attendance');

            return response()->json([
                'code' => 200,
                'status' => 'success',
                'data' => $attendance,
                'message' => 'Calendar data retrieved successfully'
            ]);

        } catch (\Exception $e) {
            \Log::error('Get calendar data error:', ['error' => $e->getMessage()]);
            return response()->json([
                'code' => 500,
                'status' => 'error',
                'data' => [],
                'message' => 'Server error: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Check out via AJAX
     */
    public function checkOut(Request $request)
    {
        try {
            DB::beginTransaction();
            
            $validated = $request->validate([
                'employee_id' => 'required|exists:employees,id',
                'date_attendance' => 'required|date',
                'time_out' => 'required|string',
                'note' => 'nullable|string|max:500',
            ]);

            // Find today's check-in record
            $checkIn = Attendance::where('employee_id', $validated['employee_id'])
                ->where('date_attendance', $validated['date_attendance'])
                ->where('type_attendance', 'check_in')
                ->first();

            if (!$checkIn) {
                return response()->json([
                    'code' => 404,
                    'status' => 'error',
                    'data' => [],
                    'message' => 'No check-in record found for today'
                ], 404);
            }

            // Check if already checked out
            $existingCheckout = Attendance::where('employee_id', $validated['employee_id'])
                ->where('date_attendance', $validated['date_attendance'])
                ->where('type_attendance', 'check_out')
                ->first();

            if ($existingCheckout) {
                return response()->json([
                    'code' => 409,
                    'status' => 'error',
                    'data' => [],
                    'message' => 'You have already checked out for today!'
                ], 409);
            }

            // Calculate working hours
            $timeIn = Carbon::createFromFormat('H:i', $checkIn->time_in);
            $timeOut = Carbon::createFromFormat('H:i', $validated['time_out']);
            $workingHours = $timeIn->diff($timeOut)->format('%H:%I');

            // Create checkout record
            $checkout = Attendance::create([
                'employee_id' => $validated['employee_id'],
                'date_attendance' => $validated['date_attendance'],
                'time_out' => $validated['time_out'],
                'working_hours' => $workingHours,
                'type_attendance' => 'check_out',
                'note' => $validated['note'] ?? null,
            ]);

            DB::commit();

            return response()->json([
                'code' => 200,
                'status' => 'success',
                'data' => $checkout,
                'message' => 'Check-out successful!',
                'working_hours' => $workingHours
            ]);

        } catch (ValidationException $e) {
            DB::rollBack();
            return response()->json([
                'code' => 422,
                'status' => 'error',
                'data' => [],
                'message' => 'Validation error',
                'errors' => $e->errors()
            ], 422);
        } catch (\Exception $e) {
            DB::rollBack();
            \Log::error('Check out error:', ['error' => $e->getMessage()]);
            return response()->json([
                'code' => 500,
                'status' => 'error',
                'data' => [],
                'message' => 'Server error: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
